      "parameters": {
        "name": "Calcular_Orcamento",
        "description": "Calcula o valor de um pacote com várias sessões de um tratamento.",
        "language": "javaScript",
        "jsCode": "const precos = { 'drenagem linfática': 150, 'limpeza de pele': 180, 'massagem relaxante': 160 };\nconst preco = precos[String(query.servico).toLowerCase()] ?? 0;\nreturn String(Math.round(preco * Number(query.sessoes) * 0.9));",
        "specifyInputSchema": true,
        "schemaType": "manual",
        "inputSchema": "{ \"type\": \"object\", \"properties\": { \"servico\": { \"type\": \"string\" }, \"sessoes\": { \"type\": \"number\" } } }"
      }
